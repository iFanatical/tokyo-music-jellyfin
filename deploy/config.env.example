# Copy to deploy/config.env and edit. config.env is gitignored, so your
# hostnames and usernames stay local.
#
#   cp deploy/config.env.example deploy/config.env
#
# Every value can also be passed as an environment variable instead, e.g.
#   REMOTE_HOST=media-box ./deploy/deploy.sh

# Hostname or IP of the machine running Jellyfin, as you reach it over SSH.
# Only used to print the right command hints.
REMOTE_HOST=

# SSH/login user on that machine. Defaults to your local $USER.
REMOTE_USER=

# Where the Jellyfin server's filesystem is mounted locally (sshfs, autofs,
# NFS…). deploy.sh copies files through this mount.
MOUNT=/mnt/jellyfin

# Directory on the server to install into. Defaults to
# /home/$REMOTE_USER/tokyo-music.
APP_DIR=

# Port the app is served on.
PORT=8097

# Address to bind. 0.0.0.0 serves the whole LAN; 127.0.0.1 is local-only.
BIND=0.0.0.0
